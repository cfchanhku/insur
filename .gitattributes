* text=auto

# Source and text files
*.dart text
*.yaml text
*.yml text
*.json text
*.arb text
*.md text
*.xml text

# Shell and platform scripts
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets and archives
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.p12 binary

# Lock files
pubspec.lock text
package-lock.json text
yarn.lock text
